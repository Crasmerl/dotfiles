#!/bin/bash
# Con background.png: todas las apps con sus colores de siempre.
# Con cualquier otro fondo: kitty, btop, cava y GTK con los colores del fondo
# (archivos que genera Noctalia desde ~/.config/noctalia/user-templates.toml).
# Y también Firefox (Pywalfox), Discord (Vesktop), tmux (~/.config/tmux/colores-fondo.conf), Neovim (~/.config/nvim/colores-fondo.lua), el borde de las ventanas de Hyprland (colores-fondo.conf o .lua según la config) y wofi (enlace ~/.config/wofi/estilo-actual.css).
# Lo llaman los hooks de Noctalia (wallpaperChange con $1 = ruta; colorGeneration y startup sin nada).

FONDO_FIJO="background.png"
TEMA_BTOP="tokyo-night"   # tema de siempre de btop
BORDE_ACTIVO="rgba(00FFEAee) rgba(40E0CFee) 45deg"   # borde de siempre (hyprland.conf)
BORDE_INACTIVO="rgba(595959aa)"
# ¿Hyprland está usando la config en Lua (hyprland.lua)? Solo entonces funciona "hyprctl eval"
lua_hypr() { [ "$(hyprctl eval 'local _ = 1' 2>/dev/null)" = "ok" ]; }

# Pone el borde de las ventanas en vivo. $1/$2 = borde activo/inactivo (formato .conf)
# o, con la config en Lua, $1 = archivo .lua con el hl.config() del borde
borde_hypr() {
    if lua_hypr; then
        hyprctl eval "$(grep -v '^\s*--' "$1")" >/dev/null   # sin comentarios: hyprctl toma "--" por una opción
    else
        hyprctl keyword general:col.active_border "$1" >/dev/null
        hyprctl keyword general:col.inactive_border "$2" >/dev/null
    fi
}
BORDE_LUA_SIEMPRE='hl.config({ general = { col = { active_border = { colors = { "rgba(00FFEAee)", "rgba(40E0CFee)" }, angle = 45 }, inactive_border = "rgba(595959aa)" } } })'
TEMA_GTK="Breeze"             # tema GTK de siempre
TEMA_GTK_FONDO="adw-gtk3-dark" # tema GTK con colores del fondo (paquete adw-gtk-theme)

# Cambia el tema GTK (gsettings y settings.ini de GTK3/4)
poner_tema_gtk() {
    gsettings set org.gnome.desktop.interface gtk-theme "$1"
    for v in 3 4; do sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$1/" ~/.config/gtk-$v.0/settings.ini; done
}

fondo="${1:-$NOCTALIA_WALLPAPER_PATH}"   # Noctalia 5 pasa el fondo en esta variable
if [ -z "$fondo" ] && pgrep -x noctalia >/dev/null; then
    # Monitor principal (el primero que da Hyprland); si no se puede saber, eDP-1
    monitor=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0].name // empty')
    fondo=$(noctalia msg wallpaper-get "${monitor:-eDP-1}" 2>/dev/null)   # Noctalia 5
fi
if [ -z "$fondo" ]; then
    sleep 1  # Noctalia guarda el fondo en caché con medio segundo de retraso
    fondo=$(python3 -c 'import json,os; d=json.load(open(os.path.expanduser("~/.cache/noctalia/wallpapers.json"))); print(next(iter(d["wallpapers"].values()))["dark"])' 2>/dev/null)
fi
[ -z "$fondo" ] && exit 0

if [ "$(basename "$fondo")" = "$FONDO_FIJO" ]; then
    # --- Colores de siempre ---
    : > ~/.config/kitty/colores-fondo.conf
    : > ~/.config/nvim/colores-fondo.lua
    : > ~/.config/hypr/colores-fondo.conf
    : > ~/.config/hypr/colores-fondo.lua
    : > ~/.config/tmux/colores-fondo.conf
    tema_apps=siempre
    ln -sfn style.css ~/.config/wofi/estilo-actual.css
    if lua_hypr; then
        hyprctl eval "$BORDE_LUA_SIEMPRE" >/dev/null
    else
        borde_hypr "$BORDE_ACTIVO" "$BORDE_INACTIVO"
    fi
    sed -i "s/^color_theme = .*/color_theme = \"$TEMA_BTOP\"/" ~/.config/btop/btop.conf
    sed -i '/^theme = "noctalia"/d' ~/.config/cava/config
    for v in 3 4; do sed -i '/noctalia\.css/d' ~/.config/gtk-$v.0/gtk.css; done
    poner_tema_gtk "$TEMA_GTK"
else
    # --- Colores del fondo ---
    cp ~/.config/kitty/themes/noctalia.conf ~/.config/kitty/colores-fondo.conf
    cp ~/.config/nvim/themes/noctalia.lua ~/.config/nvim/colores-fondo.lua
    cp ~/.config/hypr/themes/noctalia-borde.conf ~/.config/hypr/colores-fondo.conf
    cp ~/.config/hypr/themes/noctalia-borde.lua ~/.config/hypr/colores-fondo.lua 2>/dev/null
    cp ~/.config/tmux/themes/noctalia.conf ~/.config/tmux/colores-fondo.conf 2>/dev/null
    tema_apps=fondo
    ln -sfn themes/noctalia.css ~/.config/wofi/estilo-actual.css
    if lua_hypr; then
        borde_hypr ~/.config/hypr/colores-fondo.lua
    else
        borde_hypr "$(sed -n 's/.*col.active_border = //p' ~/.config/hypr/colores-fondo.conf)" \
                   "$(sed -n 's/.*col.inactive_border = //p' ~/.config/hypr/colores-fondo.conf)"
    fi
    sed -i 's/^color_theme = .*/color_theme = "noctalia"/' ~/.config/btop/btop.conf
    grep -q '^theme = "noctalia"' ~/.config/cava/config || sed -i '/^\[color\]/a theme = "noctalia"' ~/.config/cava/config
    for v in 3 4; do
        grep -q 'noctalia\.css' ~/.config/gtk-$v.0/gtk.css || echo '@import url("noctalia.css");' >> ~/.config/gtk-$v.0/gtk.css
    done
    [ -d /usr/share/themes/$TEMA_GTK_FONDO ] && poner_tema_gtk "$TEMA_GTK_FONDO"
fi

# Firefox (Pywalfox) y Discord (Vesktop): turquesa de siempre o colores del fondo
APPS=~/.config/noctalia/colores-apps
mkdir -p ~/.cache/wal ~/.config/vesktop/themes
cp "$APPS/pywalfox-$tema_apps.json" ~/.cache/wal/colors.json 2>/dev/null
cp "$APPS/discord-$tema_apps.css" ~/.config/vesktop/themes/colores-fondo.theme.css 2>/dev/null

# Icono del prompt (Starship lee su config en cada prompt: no hace falta recargar)
# Los fondos de Adachi Rei llevan su propio icono; el resto, el de siempre
case "$(basename "${fondo,,}")" in
    *adachi*) icono=$'' ;;
    *)        icono=$'\U000f117d' ;;
esac
sed --follow-symlinks -i -E "s/^(Arch|CachyOS|Linux) = \".*\"$/\1 = \"$icono \"/" ~/.config/starship.toml

# Recargar las apps abiertas
pkill -USR1 -x kitty
pkill -USR2 -x btop
pkill -USR1 -x cava
# tmux: recargar su config (si hay sesiones abiertas)
tmux source-file ~/.tmux.conf 2>/dev/null
# Firefox (Vesktop recarga el tema solo al cambiar el archivo)
command -v pywalfox >/dev/null && timeout 5 pywalfox update >/dev/null 2>&1
for s in "${XDG_RUNTIME_DIR:-/run/user/$UID}"/nvim.*; do
    [ -S "$s" ] && timeout 2 nvim --server "$s" --remote-expr 'execute("colorscheme cenote")' >/dev/null 2>&1
done
exit 0
